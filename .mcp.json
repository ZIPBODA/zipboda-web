{
  "mcpServers": {
    "figma": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      }
    },
    "talk-to-figma": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "cursor-talk-to-figma-mcp"
      ]
    }
  }
}
