# figma-developer-mcp 용 Figma 개인 액세스 토큰
# 실제 값은 커밋하지 말 것. 로컬 .env 에만 저장.
FIGMA_API_KEY=figd_your_personal_access_token_here

# GitHub Packages(@zipboda 사설 패키지) 설치용 토큰 (read:packages) — 커밋 금지
NODE_AUTH_TOKEN=ghp_your_token_here

# 카카오맵 JavaScript 키. 비어 있으면 지도는 카카오맵 링크 대체 표시로 간다(빌드·테스트는 그대로 통과).
# 빌드 시점에 값이 박히므로 Vercel에 넣은 뒤 반드시 재배포한다. 카카오 콘솔의 Web 플랫폼에 도메인 등록도 필요하다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# 카카오 로컬 REST API 키 — scripts/geocode-housing.ts 로컬 1회 실행 전용. 배포 환경에는 넣지 않는다.
KAKAO_REST_API_KEY=
